<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit cleartext HTTP for third-party Linux ISO mirror redirects & user LAN repos -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Enforce HTTPS strictly for official Microsoft CDN & GitHub engine/catalog domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">microsoft.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">ntriver.org</domain>
    </domain-config>
</network-security-config>
