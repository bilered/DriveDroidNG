<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher_ddng"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_ddng"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketBoot">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UsbKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="USB ConfigFS gadget keep-alive wake lock and UDC rebind watchdog" />
        </service>

        <service
            android:name=".TurboDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".UsbBuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="USB bootable image creation wake lock and live build progress notification" />
        </service>

        <receiver
            android:name=".DisconnectReceiver"
            android:exported="false" />

        <receiver
            android:name=".TurboDownloadActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".UsbBuildActionReceiver"
            android:exported="false" />

        <service
            android:name=".UnmountTileService"
            android:exported="true"
            android:icon="@drawable/ic_usb"
            android:label="PocketBoot USB"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
